{
  "manifest_version": 3,
  "name": "GCloud Router",
  "description": "Redirect matching URLs to configured destinations using regex patterns, and open Slack links in the Slack app.",
  "version": "0.2.0",
  "permissions": ["storage", "webNavigation", "tabs", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
